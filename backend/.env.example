PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=your mongodb atlas uri here

# JWT secret
JWT_SECRET=your_jwt_secret_key_here

FRONTEND_URL=http://localhost:3000

# ImageKit Credentials (for food image uploads)
IMAGEKIT_URL_ENDPOINT=your imagekit url endpoint here
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key

# Email configuration (Nodemailer / Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Barwaaqo Restaurant <your_email@gmail.com>

# EVC Demo Pin
EVC_DEMO_PIN=1234
